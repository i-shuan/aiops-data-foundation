# applications/<app-name>/app.yaml
# 前面這些是你們現有的欄位，照原樣。
apiVersion: platform.example.com/v1alpha1
kind: ArgoApplicationConfig
project: ai-platform
namespace: zk-mes-api-prod
environment: production
owner: mes-team
criticality: high
sync:
  automated: false
  prune: false
  selfHeal: false
helm:
  local: true
  valueFiles:
    - values-prod.yaml

# ── 新增：這個 app 的資料屬於誰、要送給誰 ──────────────────
# ApplicationSet 會把它貼到 namespace 上，vmagent 和 Fluentd 讀的就是那個。
observability:
  # 必填。這份資料是哪個部門的，只有一個值。
  dept: D3120
  # 選填。這個 app 屬於哪個業務系統，分析時用。
  system: mes
  # 選填，平常不要寫。不寫的話依 dept 自動推出（D3120 → it）。
  # 只有「一份資料要給多個 tenant 看」時才寫，用點隔開：
  # group: it.imc
