{{- /*
  把 app.yaml 的 observability 區塊貼到這個 app 的 namespace 上。
  併進 applicationsets/devops/applicationset.yaml 的 templatePatch。

  這份是 ownership 規則唯一的來源：
    - dept → group 的對照就是下面這個 dict，改組只改這裡
    - validate_observability.py 直接讀這個 dict，CI 跟 ArgoCD 用的是同一份
*/ -}}
{{- $groups := dict
      "D3120" "it"
      "D3130" "it"
      "D1110" "imc"
      "D1120" "imc"
      "PLATFORM" "platform" }}
{{- /*
  用 dig 取值：app.yaml 沒寫某個欄位時回傳空字串，就算開了 missingkey=error 也不會失敗。
  group 沒寫就依 dept 查表；有寫（例如 it.imc，要多送給別的 tenant）就用寫的。
*/ -}}
{{- $dept := dig "observability" "dept" "" . }}
{{- $group := dig "observability" "group" "" . | default (get $groups $dept) }}
{{- $system := dig "observability" "system" "" . }}
spec:
  syncPolicy:
    syncOptions:
      # managedNamespaceMetadata 只有在 CreateNamespace=true 時才生效。
      # 注意：templatePatch 裡的 list 是整個取代，不是合併。
      # 你們現有的 syncOptions 要一起寫進來，不然會被這裡蓋掉。
      - CreateNamespace=true
    managedNamespaceMetadata:
      labels:
        dept: {{ $dept | quote }}
        group: {{ $group | quote }}
        {{- /* system 沒填就整個不寫。寫成空字串的話 Fluentd 會拿到 ""，不會變成 unknown。 */}}
        {{- with $system }}
        system: {{ . | quote }}
        {{- end }}
