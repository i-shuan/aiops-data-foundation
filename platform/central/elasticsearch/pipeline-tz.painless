// 應用自己寫的時間（_app_ts）從哪來、有沒有帶時區。結果：
//   log.timestamp_source = app             應用的時間，帶了時區（或是 epoch，本來就是 UTC）
//                        = app_assumed_tz  應用的時間，沒帶時區：依 params.tz 解讀，event.timezone 記用了哪個時區
//                        = collector       應用沒寫時間，用 Collector 讀到的
//                        = collector_unparsed（後面的 date processor 設）應用寫了、但格式不認得，用 Collector 讀到的
// 為什麼要記：沒帶時區的時間以前被當成 UTC（台灣的服務差 8 小時），格式不認得的會默默換成 Collector 的時間；
// 這兩種都會讓「誰先變壞」排錯順序，要看得出來是哪些服務。
if (ctx.log == null || !(ctx.log instanceof Map)) { ctx.log = new HashMap(); }
if (ctx._app_ts == null) { ctx.log.timestamp_source = 'collector'; return; }
String t = ctx._app_ts.toString().trim();
if (t.length() == 0) { ctx.log.timestamp_source = 'collector'; return; }
boolean digits = true;
for (int i = 0; i < t.length(); i++) { if (!Character.isDigit(t.charAt(i))) { digits = false; break; } }
// epoch：10 位是秒、13 位是毫秒（date processor 的 UNIX_MS 會把秒當成毫秒，變成 1970 年），統一成毫秒
if (digits) {
  if (t.length() == 10) { ctx._app_ts = t + '000'; }
  ctx.log.timestamp_source = 'app';
  return;
}
// 結尾是 Z 或 ±hh:mm、±hhmm、±hh：帶了時區
char last = t.charAt(t.length() - 1);
boolean zoned = last == (char) 'Z' || last == (char) 'z';
if (!zoned) {
  int plus = t.lastIndexOf('+');
  int minus = t.lastIndexOf('-');
  int k = plus > minus ? plus : minus;
  int tt = t.indexOf('T');
  int sp = t.indexOf(' ');
  int tpos = tt > sp ? tt : sp;
  // '-' 也出現在日期裡（2026-10-24），所以要在時間部分（T 或空白之後）才算時區
  if (k > tpos && tpos > 0) {
    String z = t.substring(k + 1).replace(':', '');
    zoned = z.length() >= 2 && z.length() <= 4;
    for (int i = 0; i < z.length(); i++) { if (!Character.isDigit(z.charAt(i))) { zoned = false; } }
  }
}
if (zoned) { ctx.log.timestamp_source = 'app'; return; }
ctx.log.timestamp_source = 'app_assumed_tz';
if (ctx.event == null || !(ctx.event instanceof Map)) { ctx.event = new HashMap(); }
ctx.event.timezone = params.tz;
