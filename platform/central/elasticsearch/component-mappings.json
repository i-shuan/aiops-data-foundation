{
  "template": {
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp": {"type": "date"},
        "message": {"type": "match_only_text"},
        "stream": {"type": "keyword"},
        "agent": {"properties": {"type": {"type": "keyword"}}},

        "log": {"properties": {
          "level": {"type": "keyword"},
          "logger": {"type": "keyword"},
          "format": {"type": "keyword"},
          "parser": {"type": "keyword"},
          "level_inferred": {"type": "boolean"},
          "timestamp_source": {"type": "keyword"}
        }},
        "process": {"properties": {
          "thread": {"properties": {"name": {"type": "keyword"}}}
        }},
        "error": {"properties": {
          "type": {"type": "keyword"},
          "stack_trace": {"type": "match_only_text"},
          "message": {"type": "keyword", "ignore_above": 1024}
        }},
        "trace": {"properties": {"id": {"type": "keyword"}}},
        "span": {"properties": {"id": {"type": "keyword"}}},

        "service": {"properties": {
          "name": {"type": "keyword"},
          "version": {"type": "keyword"},
          "namespace": {"type": "keyword"}
        }},

        "labels": {"properties": {
          "group": {"type": "keyword"},
          "dept": {"type": "keyword"}
        }},
        "orchestrator": {"properties": {
          "cluster": {"properties": {"name": {"type": "keyword"}}}
        }},
        "kubernetes": {"properties": {
          "namespace": {"type": "keyword"},
          "pod": {"properties": {"name": {"type": "keyword"}, "uid": {"type": "keyword"}}},
          "container": {"properties": {"name": {"type": "keyword"}}},
          "node": {"properties": {"name": {"type": "keyword"}}},
          "labels": {"type": "flattened"}
        }},
        "container": {"properties": {
          "id": {"type": "keyword"},
          "image": {"properties": {"name": {"type": "keyword"}}}
        }},

        "app": {"type": "flattened"},

        "resource": {"properties": {"attributes": {"properties": {
          "service": {"properties": {"name": {"type": "alias", "path": "service.name"}}},
          "k8s": {"properties": {
            "namespace": {"properties": {"name": {"type": "alias", "path": "kubernetes.namespace"}}},
            "pod": {"properties": {"name": {"type": "alias", "path": "kubernetes.pod.name"}}},
            "container": {"properties": {"name": {"type": "alias", "path": "kubernetes.container.name"}}},
            "node": {"properties": {"name": {"type": "alias", "path": "kubernetes.node.name"}}},
            "cluster": {"properties": {"name": {"type": "alias", "path": "orchestrator.cluster.name"}}}
          }}
        }}}},
        "trace_id": {"type": "alias", "path": "trace.id"},
        "span_id": {"type": "alias", "path": "span.id"},
        "event": {"properties": {"ingested": {"type": "date"}, "created": {"type": "date"}, "timezone": {"type": "keyword"}}}
      }
    }
  },
  "_meta": {"description": "k8s log 欄位。標準概念用 ECS 名稱；應用自帶的其他欄位一律收進 app（flattened），避免欄位數爆掉。resource.attributes.*、trace_id、span_id 是 alias：跟 metrics、trace 同一條路徑查（不佔空間、_source 裡沒有，要用 fields 取）"}
}
