{
  "policy": {
    "_meta": {
      "description": "k8s log（k8s-*）原文：__LOGS_DELETE_AFTER__ 刪；長期改留統計（aiops-log-stats）。天數改 platform/central/retention.conf"
    },
    "phases": {
      "hot": {
        "actions": {
          "rollover": {
            "max_primary_shard_size": "30gb",
            "max_age": "__ROLLOVER_MAX_AGE__"
          }
        }
      },
      "delete": {
        "min_age": "__LOGS_DELETE_AFTER__",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
