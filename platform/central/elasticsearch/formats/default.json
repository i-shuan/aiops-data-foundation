{
  "description": "格式 default：沒宣告格式的服務都走這裡。JSON 就拆（logback、ECS 都認得），不是 JSON 就保留原文",
  "processors": [
    {"set": {"field": "log.parser", "value": "default"}},
    {
      "json": {
        "field": "message",
        "target_field": "_app",
        "if": "ctx.message instanceof String && ctx.message.trim().startsWith('{')",
        "ignore_failure": true
      }
    },
    {"pipeline": {"name": "k8s-logs-fields"}}
  ]
}
