{
  "uid": "aiops-rca-demo",
  "title": "AIOps RCA demo：metrics → trace → log → AI 根因",
  "tags": [
    "aiops",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "① Metrics：rca-mes-api 的 p95 延遲（HTTP 直方圖）",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "demo-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "demo-metrics"
          },
          "query": "resource.attributes.service.name:\"rca-mes-api\" AND _exists_:metrics.http.server.request.duration",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "percentiles",
              "field": "metrics.http.server.request.duration",
              "settings": {
                "percents": [
                  "95"
                ]
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "30s",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "② Trace：GET /lots/{id} 請求數，依結果（Error 是失敗）",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "demo-traces"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "demo-traces"
          },
          "query": "resource.attributes.service.name:\"rca-mes-api\" AND kind:Server",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "status.code",
              "settings": {
                "size": "5",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1",
                "missing": "OK"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "30s",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "③ Trace：最近的 span，每一段屬於哪個 trace_id、花多久（同一個 trace_id 連在一起看）",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "demo-traces"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 290
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "服務"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "耗時"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "trace_id",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "demo-traces"
          },
          "query": "resource.attributes.service.name:(\"rca-mes-api\" OR \"rca-wip-worker\")",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "200"
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "trace_id": true,
              "resource.attributes.service.name": true,
              "name": true,
              "duration": true
            },
            "indexByName": {
              "trace_id": 0,
              "resource.attributes.service.name": 1,
              "name": 2,
              "duration": 3
            },
            "renameByName": {
              "resource.attributes.service.name": "服務",
              "name": "哪一段",
              "duration": "耗時"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "④ Log：每一筆帶 trace_id，貼 ③ 的 trace_id 用 ctrl+F 找（ERROR 標紅）",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "demo-logs"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "displayedFields": [
          "trace.id",
          "___LOG_LINE_BODY___"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "demo-logs"
          },
          "query": "service.name:(\"rca-mes-api\" OR \"rca-wip-worker\")",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "logs",
              "settings": {
                "limit": "500"
              }
            }
          ],
          "bucketAggs": []
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "⑤ AIOps：合成的事件（一列一件；title 那格點眼睛：AI 摘要、根因分析、最下面老師傅回饋網址；「老師傅回饋」點一下開表單）",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "demo-alerts"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "started_at"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dept"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "anomaly_count"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "report_titled"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 320
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "新分頁開這件的報告全文",
                    "url": "${__data.fields.report_url}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "title"
              },
              {
                "id": "custom.inspect",
                "value": true
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^([^\\n]*)[\\s\\S]*$",
                      "result": {
                        "text": "$1"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alert_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "report_url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "feedback_url"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "老師傅回饋"
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^http.*$",
                      "result": {
                        "text": "✍ 填回饋"
                      }
                    }
                  }
                ]
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "老師傅回饋（全文在上、表單在下）",
                    "url": "${__value.raw}&full=1",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "demo-alerts"
          },
          "query": "category:service",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "20"
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "started_at": true,
              "status": true,
              "severity": true,
              "service": true,
              "dept": true,
              "anomaly_count": true,
              "alert_id": true,
              "report_url": true,
              "feedback_url": true,
              "report_titled": true
            },
            "indexByName": {
              "started_at": 0,
              "status": 1,
              "severity": 2,
              "service": 3,
              "dept": 4,
              "anomaly_count": 7,
              "alert_id": 8,
              "report_url": 9,
              "feedback_url": 6,
              "report_titled": 5
            }
          }
        }
      ]
    }
  ]
}
