[
  {"group": "格式", "name": "Java logstash encoder＋MDC（trace_id、span_id）",
   "log": "{\"@timestamp\":\"2026-10-27T01:02:03.456Z\",\"level\":\"ERROR\",\"logger_name\":\"c.m.LotService\",\"message\":\"Connection pool timeout\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\",\"span_id\":\"00f067aa0ba902b7\",\"trace_flags\":\"01\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "格式", "name": ".NET JSON console＋IncludeScopes（Scopes 裡的 TraceId、SpanId）",
   "log": "{\"Timestamp\":\"2026-10-27T01:02:03.4567890Z\",\"LogLevel\":\"Error\",\"Category\":\"Mes.Wip\",\"Message\":\"Npgsql timeout\",\"Scopes\":[{\"Message\":\"SpanId:00f067aa0ba902b7, TraceId:4bf92f3577b34da6a3ce929d0e0e4736, ParentId:0000000000000000\",\"SpanId\":\"00f067aa0ba902b7\",\"TraceId\":\"4bf92f3577b34da6a3ce929d0e0e4736\",\"ParentId\":\"0000000000000000\"}]}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "格式", "name": "Serilog compact（@tr、@sp）",
   "log": "{\"@t\":\"2026-10-27T01:02:03.4567890Z\",\"@mt\":\"Processing {OrderId}\",\"@l\":\"Warning\",\"@tr\":\"4bf92f3577b34da6a3ce929d0e0e4736\",\"@sp\":\"00f067aa0ba902b7\",\"OrderId\":1234}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "格式", "name": "logfmt（log-format: logfmt）", "format": "logfmt",
   "log": "ts=2026-10-27T01:02:03.456Z level=warn msg=\"lot hold\" trace_id=4bf92f3577b34da6a3ce929d0e0e4736 span_id=00f067aa0ba902b7 lot_id=L123",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "格式", "name": "ECS（扁平的 trace.id、span.id；co.elastic.logging）",
   "log": "{\"@timestamp\":\"2026-10-27T01:02:03.456Z\",\"log.level\":\"WARN\",\"message\":\"slow query\",\"ecs.version\":\"1.2.0\",\"trace.id\":\"4bf92f3577b34da6a3ce929d0e0e4736\",\"span.id\":\"00f067aa0ba902b7\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "格式", "name": "ECS（巢狀的 trace: {id}、span: {id}）",
   "log": "{\"@timestamp\":\"2026-10-27T01:02:03.456Z\",\"log\":{\"level\":\"INFO\"},\"message\":\"lot started\",\"trace\":{\"id\":\"4bf92f3577b34da6a3ce929d0e0e4736\"},\"span\":{\"id\":\"00f067aa0ba902b7\"}}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "格式", "name": "純文字，沒有 trace_id",
   "log": "2026-10-27 09:02:03.456  ERROR 1 --- [nio-8080-exec-3] c.m.LotService : Connection pool timeout",
   "expect": {}},
  {"group": "格式", "name": "多行 stack trace 在 JSON 裡（stack_trace 帶換行）",
   "log": "{\"@timestamp\":\"2026-10-27T01:02:03.456Z\",\"level\":\"ERROR\",\"message\":\"order 5 failed\",\"stack_trace\":\"java.lang.IllegalStateException: boom\\n\\tat c.m.OrderService.place(OrderService.java:42)\\n\\tat c.m.OrderController.post(OrderController.java:17)\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\",\"span_id\":\"00f067aa0ba902b7\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "格式", "name": "純文字 stack trace 的續行（每行各一筆，不綁）",
   "log": "\tat c.m.OrderService.place(OrderService.java:42)",
   "expect": {}},
  {"group": "格式", "name": "otel.logs.exporter: otlp 直送（body 純文字，trace 在 log record）", "kind": "otlp",
   "log": "order 5 handled",
   "otel": {"trace_id": "4bf92f3577b34da6a3ce929d0e0e4736", "span_id": "00f067aa0ba902b7", "severity_text": "INFO"},
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7", "source": "otlp"}},

  {"group": "值", "name": "大寫 hex → 轉小寫",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4BF92F3577B34DA6A3CE929D0E0E4736\",\"span_id\":\"00F067AA0BA902B7\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "值", "name": "前後有空白 → 去掉",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\" 4bf92f3577b34da6a3ce929d0e0e4736 \",\"span_id\":\"00f067aa0ba902b7\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "值", "name": "全 0（沒有 context）→ 不設、也不算格式錯",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"00000000000000000000000000000000\",\"span_id\":\"0000000000000000\"}",
   "expect": {}},
  {"group": "值", "name": "64 位元短 id（16 個 hex，B3）→ 前面補 16 個 0",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"traceId\":\"a3ce929d0e0e4736\",\"spanId\":\"00f067aa0ba902b7\"}",
   "expect": {"trace": "0000000000000000a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "值", "name": "長度錯（31 個）→ 不設，原值留在 app.trace_id_invalid",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e473\",\"span_id\":\"00f067aa0ba902b7\"}",
   "expect": {"span": "00f067aa0ba902b7", "trace_invalid": "4bf92f3577b34da6a3ce929d0e0e473"}},
  {"group": "值", "name": "含非 hex 字元（g）→ 不設，原值留著",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e47zg\",\"span_id\":\"00f067aa0ba902b7\"}",
   "expect": {"span": "00f067aa0ba902b7", "trace_invalid": "4bf92f3577b34da6a3ce929d0e0e47zg"}},
  {"group": "值", "name": "GUID 帶減號（36 個字）→ 不設，原值留著",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4bf92f35-77b3-4da6-a3ce-929d0e0e4736\"}",
   "expect": {"trace_invalid": "4bf92f35-77b3-4da6-a3ce-929d0e0e4736"}},
  {"group": "值", "name": "MDC 空字串（背景工作的 logback）→ 不設",
   "log": "{\"level\":\"INFO\",\"message\":\"nightly purge done\",\"trace_id\":\"\",\"span_id\":\"\"}",
   "expect": {}},

  {"group": "欄位名", "name": "traceId／spanId（camelCase）",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"traceId\":\"4bf92f3577b34da6a3ce929d0e0e4736\",\"spanId\":\"00f067aa0ba902b7\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "欄位名", "name": "TraceId／SpanId 在最外層（不在 Scopes）",
   "log": "{\"LogLevel\":\"Information\",\"Message\":\"x\",\"TraceId\":\"4bf92f3577b34da6a3ce929d0e0e4736\",\"SpanId\":\"00f067aa0ba902b7\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7"}},
  {"group": "欄位名", "name": "dd.trace_id（Datadog，十進位）→ 不拿，留在 app",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"dd.trace_id\":\"1234567890123456789\",\"dd.span_id\":\"987654321\"}",
   "expect": {"app": {"dd.trace_id": "1234567890123456789"}}},
  {"group": "欄位名", "name": "trace_id 和 dd.trace_id 都有 → 用 trace_id",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\",\"dd.trace_id\":\"1234567890123456789\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "app": {"dd.trace_id": "1234567890123456789"}}},

  {"group": "span", "name": "只有 trace 沒有 span",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736"}},
  {"group": "span", "name": "span_id 格式錯（15 個）→ trace 照設，span 不設",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\",\"span_id\":\"00f067aa0ba902b\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span_invalid": "00f067aa0ba902b"}},
  {"group": "span", "name": "span_id 寫成 32 個（誤填 trace_id）→ span 不設",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\",\"span_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span_invalid": "4bf92f3577b34da6a3ce929d0e0e4736"}},

  {"group": "時間", "name": "log 時間比 span 早 10 分鐘：trace.id 不受影響、@timestamp 用應用的",
   "log": "{\"@timestamp\":\"2026-10-27T00:52:03.456Z\",\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "timestamp": "2026-10-27T00:52:03.456Z"}},
  {"group": "時間", "name": "log 時間比 span 晚 10 分鐘",
   "log": "{\"@timestamp\":\"2026-10-27T01:12:03.456Z\",\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\"}",
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "timestamp": "2026-10-27T01:12:03.456Z"}},

  {"group": "沒有 trace", "name": "OTLP 直送、背景工作（record 沒有 trace_id）→ 不設",  "kind": "otlp",
   "log": "nightly purge done",
   "otel": {"severity_text": "INFO"},
   "expect": {"source": "otlp"}},
  {"group": "沒有 trace", "name": "OTLP 直送、trace_id 全 0 → 不設",  "kind": "otlp",
   "log": "nightly purge done",
   "otel": {"trace_id": "00000000000000000000000000000000", "span_id": "0000000000000000", "severity_text": "INFO"},
   "expect": {"source": "otlp"}},
  {"group": "沒有 trace", "name": "訊息內文有一串 hex → 不拿",
   "log": "retry batch 4bf92f3577b34da6a3ce929d0e0e4736 after timeout",
   "expect": {}},
  {"group": "沒有 trace", "name": "JSON 沒 trace 欄位、自訂欄位叫 request_id → 不拿",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"request_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\"}",
   "expect": {"app": {"request_id": "4bf92f3577b34da6a3ce929d0e0e4736"}}},

  {"group": "原文 vs record", "name": "OTLP：body 的 trace_id 格式錯、record 的對 → 用 record 的", "kind": "otlp",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"not-a-trace\"}",
   "otel": {"trace_id": "4bf92f3577b34da6a3ce929d0e0e4736", "span_id": "00f067aa0ba902b7", "severity_text": "INFO"},
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "span": "00f067aa0ba902b7", "trace_invalid": "not-a-trace", "source": "otlp"}},
  {"group": "原文 vs record", "name": "OTLP：body 有對的、record 也有 → 用 body 的（原文優先）", "kind": "otlp",
   "log": "{\"level\":\"INFO\",\"message\":\"x\",\"trace_id\":\"4bf92f3577b34da6a3ce929d0e0e4736\"}",
   "otel": {"trace_id": "11111111111111111111111111111111", "severity_text": "INFO"},
   "expect": {"trace": "4bf92f3577b34da6a3ce929d0e0e4736", "source": "otlp"}}
]
