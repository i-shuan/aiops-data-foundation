<?xml version="1.0" encoding="UTF-8"?>
<!--
  Java（Spring Boot／Logback）的 log 輸出範本。
  需要依賴 net.logstash.logback:logstash-logback-encoder。

  輸出到 stdout，一行一個 JSON，欄位符合根目錄 README.md「log 格式」的規範：
    timestamp（UTC）、level、message、logger、thread、stack_trace、
    trace_id／span_id（由 OpenTelemetry Java agent 寫進 MDC，這裡自動帶出）
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <timeZone>UTC</timeZone>
      <fieldNames>
        <timestamp>timestamp</timestamp>
        <logger>logger</logger>
        <thread>thread</thread>
        <version>[ignore]</version>
        <levelValue>[ignore]</levelValue>
      </fieldNames>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
