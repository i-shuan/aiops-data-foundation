{
  "description": "格式 logfmt：level=info msg=\"order failed\" lot_id=L123 這種 key=value，Go 等語言常見",
  "processors": [
    {"set": {"field": "log.parser", "value": "logfmt"}},
    {
      "kv": {
        "field": "message",
        "target_field": "_app",
        "field_split": " (?=[\\w.@-]+=)",
        "value_split": "=",
        "trim_value": "\"",
        "if": "ctx.message instanceof String && ctx.message.contains('=')",
        "ignore_failure": true
      }
    },
    {"pipeline": {"name": "k8s-logs-fields"}}
  ]
}
