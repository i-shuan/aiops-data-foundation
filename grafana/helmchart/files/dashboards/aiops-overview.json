      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "⑥ AIOps：根因分析報告全文（metrics 異常 → trace 哪一段 → 那一段的 log）",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-db"
      },
      "gridPos": {
        "x": 0,
