    {
      "id": 4,
      "type": "table",
      "title": "調整建議（回饋 → 建議 → 回測 → 人核准 → 偵測下一輪直接吃）",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-db"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT doc->>'at' AS at, doc->>'kind' AS kind, doc->>'status' AS status, doc->>'series' AS series, COALESCE(doc->'match'->>'service', doc->>'service') AS service, (doc->>'z')::float AS z, doc->>'reason' AS reason, doc->'backtest'->>'anomalies_before' AS \"backtest.anomalies_before\", doc->'backtest'->>'anomalies_after' AS \"backtest.anomalies_after\", doc->'backtest'->>'recommended' AS \"backtest.recommended\", doc->>'approved_by' AS approved_by FROM aiops_tuning WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 50"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "at": true,
              "kind": true,
              "status": true,
              "series": true,
              "service": true,
              "z": true,
              "reason": true,
              "backtest.anomalies_before": true,
              "backtest.anomalies_after": true,
              "backtest.recommended": true,
              "approved_by": true
            },
            "indexByName": {
              "at": 0,
              "kind": 1,
              "status": 2,
              "series": 3,
              "service": 4,
              "z": 5,
              "reason": 6,
              "backtest.anomalies_before": 7,
              "backtest.anomalies_after": 8,
              "backtest.recommended": 9,
              "approved_by": 10
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reason"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "kind"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "z"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
