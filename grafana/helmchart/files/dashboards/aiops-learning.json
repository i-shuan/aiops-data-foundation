      "title": "mes-report 月底批次：目前被判為異常的筆數",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-db"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), count(*) AS value FROM aiops_anomalies WHERE $__timeFilter(ts) AND doc->'keys'->>'service' = 'mes-report' AND doc->>'series' = 'synth.requests' AND doc->>'status' = 'anomaly' GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "0",
          "unit": "none",
          "displayName": "mes-report 月底批次：目前被判為異常的筆數"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
