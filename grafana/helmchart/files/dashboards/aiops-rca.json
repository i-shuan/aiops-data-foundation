  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "事故清單：一列 = 一件事故（一個服務在一段時間內的所有異常合成一件）",
      "description": "engine 每分鐘把同一個服務、時間相連的異常合成一件事故（PostgreSQL 的 aiops_alerts 一筆）。「合併的異常筆數」是這件合進來幾筆異常（aiops_anomalies）；30 分鐘沒有新異常就結案。上面選一件，下面看它的 LLM 摘要、相似事故與根因報告。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-db"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT doc->>'started_at' AS started_at, doc->>'status' AS status, doc->>'severity' AS severity, doc->>'service' AS service, doc->>'dept' AS dept, (doc->>'anomaly_count')::int AS anomaly_count, doc->>'title' AS title, doc->>'alert_id' AS alert_id FROM aiops_alerts WHERE $__timeFilter(ts) AND doc->>'category' = 'service' ORDER BY doc->>'started_at' DESC LIMIT 50"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "started_at": true,
              "status": true,
              "severity": true,
              "service": true,
              "dept": true,
              "anomaly_count": true,
              "title": true
            },
            "indexByName": {
              "started_at": 0,
              "status": 1,
              "severity": 2,
              "service": 3,
              "dept": 4,
              "anomaly_count": 5,
              "title": 6
            },
            "renameByName": {
              "started_at": "開始時間",
              "status": "狀態",
              "severity": "嚴重度",
              "service": "服務",
              "dept": "部門",
              "anomaly_count": "合併的異常筆數",
              "title": "標題"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "started_at",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "started_at"
            },
            "properties": [
              {
                "id": "custom.width",
