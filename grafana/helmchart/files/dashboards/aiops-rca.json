            "uid": "aiops-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT doc->>'llm_provider' AS llm_provider, doc->>'llm_summary' AS llm_summary FROM aiops_alerts WHERE id = '${alert}' LIMIT 1"
        }
      ],
      "transformations": [
