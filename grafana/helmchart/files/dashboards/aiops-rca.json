  "tags": [
    "aiops"
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "事故清單：一列 = 一件事故（一個服務在一段時間內的所有異常合成一件）",
      "description": "engine 每分鐘把同一個服務、時間相連的異常合成一件事故（aiops-alerts 一筆）。「合併的異常筆數」是這件合進來幾筆異常（aiops-anomalies）；30 分鐘沒有新異常就結案。上面選一件，下面看它的 LLM 摘要、相似事故與根因報告。",
      "datasource": {
        "type": "elasticsearch",
        "uid": "aiops-alerts"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "aiops-alerts"
          },
          "query": "category:service",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "50"
              }
            }
          ],
          "bucketAggs": [],
          "timeField": "@timestamp"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "started_at": true,
              "status": true,
              "severity": true,
              "service": true,
              "dept": true,
              "anomaly_count": true,
              "title": true
            },
            "indexByName": {
              "started_at": 0,
              "status": 1,
              "severity": 2,
              "service": 3,
              "dept": 4,
              "anomaly_count": 5,
              "title": 6
            },
            "renameByName": {
              "started_at": "開始時間",
              "status": "狀態",
              "severity": "嚴重度",
              "service": "服務",
              "dept": "部門",
              "anomaly_count": "合併的異常筆數",
              "title": "標題"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "started_at",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "started_at"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dept"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "anomaly_count"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "LLM 摘要（每句附依據；驗不過退回模板）",
      "description": "依據 id：T=trace 段、A=異常、S=統計、E=例外、L=log 樣式、I=過去相似事故",
      "datasource": {
        "type": "elasticsearch",
        "uid": "aiops-alerts"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
