    {
      "id": 5,
      "type": "table",
      "title": "這件事故的異常",
      "description": "aiops_anomalies（PostgreSQL）裡 alert_id 是這件的：動態基準線的（status、z）和規則觸發的（severity、message）都在。alert_id 是 investigator alert 併件時寫回的。",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aiops-db"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aiops-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT doc->>'@timestamp' AS \"@timestamp\", doc->>'status' AS status, doc->>'severity' AS severity, doc->>'series' AS series, COALESCE(doc->'keys'->>'service', doc->'keys'->>'service.name') AS \"keys.service\", (doc->>'value')::float AS value, (doc->>'median')::float AS median, (doc->>'expected_high')::float AS expected_high, (doc->>'z')::float AS z, doc->>'direction' AS direction, doc->>'confidence' AS confidence, doc->>'message' AS message FROM aiops_anomalies WHERE doc->>'alert_id' = '${alert}' ORDER BY ts LIMIT 200"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "@timestamp": true,
              "status": true,
              "severity": true,
              "series": true,
              "keys.service": true,
              "value": true,
              "median": true,
              "expected_high": true,
              "z": true,
              "direction": true,
              "confidence": true,
              "message": true
            },
            "indexByName": {
              "@timestamp": 0,
              "status": 1,
              "severity": 2,
              "series": 3,
              "keys.service": 4,
              "value": 5,
              "median": 6,
              "expected_high": 7,
              "z": 8,
              "direction": 9,
              "confidence": 10,
              "message": 11
            },
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "@timestamp",
                "desc": true
              }
            ]
          }
        }
