{
  "uid": "aiops-rca",
  "title": "AIOps 事故與根因",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Taipei",
  "refresh": "",
  "time": {
    "from": "now-7d",
