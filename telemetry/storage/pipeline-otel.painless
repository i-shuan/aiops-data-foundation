// OpenTelemetry Collector（telemetry/collectors）送來的 log：
// 整理成 Fluent Bit 送來的形狀，改寫 _index 轉到 k8s-<group>-<cluster>，接著在 k8s-logs-otel 裡呼叫 k8s-logs，
// 拆欄位的規則跟 Fluent Bit 那條完全共用。
// ⚠ 改了 _index 之後 ES 不會自動跑目的地的 default pipeline（實測），所以要自己呼叫。

Map res = ctx.resource == null ? null : ctx.resource.get('attributes');
if (res == null || res.get('group') == null || res.get('k8s.cluster.name') == null) {
  return;   // 不是我們的 Collector 送的，不動
}
Map attrs = ctx.attributes == null ? new HashMap() : ctx.attributes;
String group = res.get('group').toString();
String cluster = res.get('k8s.cluster.name').toString();

// pod label：Collector 以 k8s.pod.labels.<名稱> 帶過來
Map podLabels = new HashMap();
for (def e : res.entrySet()) {
  String key = e.getKey();
  if (key.startsWith('k8s.pod.labels.')) podLabels.put(key.substring(15), e.getValue());
}

String raw = null;
def body = ctx.body;
if (body instanceof Map) raw = body.get('text');
else if (body != null) raw = body.toString();

// image：新版 Collector 的 tag 在 container.image.tags（陣列），舊版在 container.image.tag
String image = res.get('container.image.name');
def tag = res.get('container.image.tags');
if (tag instanceof List) tag = tag.isEmpty() ? null : tag.get(0);
if (tag == null) tag = res.get('container.image.tag');
if (image != null && tag != null) image = image + ':' + tag;

// 去重複用的原料（下一步 fingerprint 算成 _id）：跟 Fluent Bit 的 generate_id 一樣用整筆內容，
// 包含 container runtime 給的奈秒時間，所以內容一樣的兩行仍是不同的 _id；同一筆被重送時 _id 相同，ES 回 409 不再寫一份
def ts = ctx['@timestamp'];
ctx._fp_src = [res.get('k8s.pod.uid'), res.get('k8s.container.name'), attrs.get('log.iostream'), ts, raw].toString();

// 時間：OTLP 進來是 epoch 毫秒（帶小數），轉成跟 Fluent Bit 一樣的 ISO 格式（到毫秒）
if (ts != null && !(ts.toString().contains('T'))) {
  ts = Instant.ofEpochMilli((long) Double.parseDouble(ts.toString())).toString();
}

Map out = new HashMap();
out.put('@timestamp', ts);
out.put('log', raw);
out.put('stream', attrs.get('log.iostream'));
out.put('group', group);
out.put('cluster', cluster);
out.put('agent', ['type': 'otelcol']);
// 從容器 log 檔讀的（file_log 一定帶 log.iostream、log.file.path）還是應用 agent 用 OTLP 直送的。
// 應用開了 otel.logs.exporter: otlp，stdout 照印，同一行會進來兩份，用 log.source 分
out.put('_log_source', attrs.get('log.iostream') != null || attrs.get('log.file.path') != null ? 'file' : 'otlp');
out.put('kubernetes', [
  'namespace_name': res.get('k8s.namespace.name'),
  'pod_name': res.get('k8s.pod.name'),
  'pod_id': res.get('k8s.pod.uid'),
  'container_name': res.get('k8s.container.name'),
  'host': res.get('k8s.node.name'),
  'docker_id': res.get('container.id'),
  'container_image': image,
  'labels': podLabels,
  // Collector 決定的服務名稱（Pod label，沒有的話 Deployment 名稱）：Pod 沒有 app.kubernetes.io/name 時 k8s-logs 用它，
  // 跟 metrics、trace 同一個名字（docs/pdca/phase1-collect/2026-10-keys-k8s.md）
  'service_name': res.get('service.name')
]);
if (res.get('dept') != null) out.put('kubernetes_namespace', ['labels': ['dept': res.get('dept')]]);

// 應用的 agent 用 OTLP 直接送來的 log（不是從容器 log 檔讀的）：trace_id、span_id、嚴重度、自訂欄位在 log record 本身，
// 不在原文裡。先帶著（_otel），k8s-logs-fields 拆完原文後拿來補（原文裡有的優先）。
// 從 log 檔讀的沒有 trace_id、severity_text（attributes 只有 log.iostream、log.file.path），不會走到這裡。
def otelTrace = ctx.get('trace_id'); if (otelTrace == null && ctx.trace instanceof Map) otelTrace = ctx.trace.get('id');
def otelSpan = ctx.get('span_id'); if (otelSpan == null && ctx.span instanceof Map) otelSpan = ctx.span.get('id');
if (otelTrace != null || ctx.get('severity_text') != null) {
  Map extra = new HashMap();
  for (def e : attrs.entrySet()) {
    String key = e.getKey();
    if (!key.startsWith('log.')) extra.put(key, e.getValue());
  }
  out.put('_otel', ['trace_id': otelTrace, 'span_id': otelSpan, 'severity_text': ctx.get('severity_text'), 'attributes': extra]);
}

// 換掉整份文件，再改目的地
for (String key : new ArrayList(ctx.keySet())) {
  if (!key.startsWith('_')) ctx.remove(key);
}
ctx.putAll(out);
ctx._index = 'k8s-' + group + '-' + cluster;
